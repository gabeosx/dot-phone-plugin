# Ordinary local settings only. Provider credentials go in .secrets/runtime.json.
DOTS_PHONE_PROFILE=production
DOTS_PHONE_PUBLIC_BASE_URL=https://configure.invalid
DOTS_PHONE_MEDIA_BASE_URL=https://configure.invalid
DOTS_PHONE_MCP_RESOURCE_URL=
DOTS_PIPECAT_TUNNEL_ID=
DOTS_PHONE_TWILIO_PHONE_NUMBER=
# Normal calls use the verified task destination; no per-number setup.
DOTS_PHONE_DESTINATION_POLICY=task_scope
# Used only for owned test campaigns or optional destination policy allowlist.
DOTS_PHONE_ALLOWED_TEST_NUMBERS=
DOTS_PHONE_CALLBACK_HOSTS=
DOTS_PHONE_OAUTH_REDIRECT_URIS=
DOTS_PHONE_DRY_RUN=true
DOTS_PHONE_VOICE_BACKEND=pipecat
DOTS_PHONE_PIPECAT_ENGINE=realtime
DOTS_PHONE_PIPECAT_REALTIME_MODEL=gpt-realtime-2.1
# Committed-turn input transcription; gpt-realtime-whisper is the explicit rollback.
DOTS_PHONE_PIPECAT_TRANSCRIPTION_MODEL=gpt-transcribe
DOTS_PHONE_PIPECAT_TURN_DETECTION=semantic_vad
DOTS_PHONE_PIPECAT_VAD_EAGERNESS=high
DOTS_PHONE_PIPECAT_VAD_SILENCE_MS=1000
DOTS_PHONE_GENERAL_VAD_THRESHOLD=0.5
# Native general calls only: 0 disables; otherwise 5000–30000 milliseconds.
DOTS_PHONE_GENERAL_VAD_IDLE_TIMEOUT_MS=0
DOTS_PHONE_GENERAL_TURN_DETECTION=server_vad
DOTS_PHONE_PIPECAT_NOISE_REDUCTION=off
# Recommended setup enables deepfilter after installing its native image and external weights.
# Bare runtime fallback stays off until provisioned; follow docs/DEEPFILTER.md.
DOTS_PHONE_PIPECAT_INPUT_FILTER=off
# Download weights outside the checkout, then mount read-only with compose.deepfilter.yaml.
DOTS_PHONE_DEEPFILTER_MODEL_FILE=
DOTS_PHONE_DEEPFILTER_MODEL_PATH=
DOTS_PHONE_DEEPFILTER_LIBRARY_PATH=/opt/deepfilter/lib/libdf.so
DOTS_PHONE_DEEPFILTER_FRAME_TIMEOUT_MS=100
# Optional independent recipient-audio evidence for post-call review. Local model only.
# Phone image includes audio-review; other installs need uv sync --extra audio-review.
# Point to a complete local faster-whisper small.en model (dereference cached symlinks).
# Mount it read-only in containers. Blank disables; retained recordings are required.
DOTS_PHONE_POST_CALL_AUDIO_MODEL_DIRECTORY=
# Optional second, larger local recognition of the same recording; medium.en.
# Both observations go to Codex as fallible evidence. Blank disables this pass.
DOTS_PHONE_POST_CALL_AUDIO_CONFIRMATION_MODEL_DIRECTORY=
# Optional IVR-only test mode; defaults off. No live-person conversation.
DOTS_PHONE_TEST_STOP_ON_HUMAN=false
DOTS_PHONE_TEST_RESPONSE_LIMIT=0
DOTS_PHONE_TRACE_REALTIME_STAGES=false
DOTS_PHONE_ACCOUNT_TASKS=true
DOTS_PHONE_LOCAL_REASONER_ENABLED=true
DOTS_PHONE_LOCAL_REASONER_MODEL=gpt-6-sol
DOTS_PHONE_LOCAL_REASONER_EFFORT=medium
DOTS_PHONE_LOCAL_REASONER_RESPONSE_POLICY=direct_with_codex
# One voice reasoning setting for every Realtime call path; Codex effort is separate.
DOTS_PHONE_LOCAL_REASONER_VOICE_EFFORT=medium
DOTS_PHONE_LOCAL_REASONER_DIRECTORY=/reasoner
DOTS_PHONE_LOCAL_REASONER_HOST_DIRECTORY=./.secrets/reasoner
DOTS_PHONE_CALL_AUTHORIZATION_MODE=connected_owner
DOTS_PHONE_CONNECTED_CALL_BUDGET_USD=3
DOTS_PHONE_CONNECTED_DAILY_BUDGET_USD=10
DOTS_PHONE_PIPECAT_ACCOUNT_DTMF=true
DOTS_PHONE_MAX_CALL_SECONDS=600
DOTS_PHONE_DECISION_TIMEOUT_SECONDS=60
DOTS_PHONE_CALL_STATE_WAIT_SECONDS=8
DOTS_PHONE_MAX_CONCURRENT_CALLS=1
DOTS_PHONE_RETAIN_RECORDING=true
DOTS_PHONE_RETAIN_TRANSCRIPT=true
DOTS_PHONE_RETENTION_SECONDS=86400
# Optional Bitwarden Secrets Manager integration; your project, no bundled default.
DOTS_PHONE_BWS_PROJECT_ID=
