[
  {
    "id": "keypad_self_service",
    "tags": [
      "keypad",
      "prefer_ivr"
    ],
    "steps": [
      {
        "recipient": "Welcome to the automated rewards line. For your available points balance, press 2. For a representative, press 0.",
        "expect": {
          "silent": true,
          "tools": [
            {
              "name": "press_phone_key",
              "arguments": {
                "digit": "2"
              }
            }
          ],
          "digits": [
            "2"
          ],
          "ended": false
        }
      },
      {
        "recipient": "Your available rewards balance is 12,340 points. This is the available balance, not pending or lifetime points. That completes this inquiry.",
        "expect": {
          "tools": [
            {
              "name": "finish_call",
              "arguments": {
                "outcome": "completed"
              }
            }
          ],
          "outcome": "completed",
          "ended": true
        }
      }
    ]
  },
  {
    "id": "nested_keypad_verification",
    "tags": [
      "keypad",
      "nested",
      "verification"
    ],
    "steps": [
      {
        "recipient": "For existing member self-service, press 3. For new membership, press 1. For a representative, press 0.",
        "expect": {
          "silent": true,
          "tools": [
            {
              "name": "press_phone_key",
              "arguments": {
                "digit": "3"
              }
            }
          ],
          "digits": [
            "3"
          ],
          "ended": false
        }
      },
      {
        "recipient": "For available points, press 4. For recent activity, press 6. For a representative, press 0.",
        "expect": {
          "silent": true,
          "tools": [
            {
              "name": "press_phone_key",
              "arguments": {
                "digit": "4"
              }
            }
          ],
          "digits": [
            "4"
          ],
          "ended": false
        }
      },
      {
        "recipient": "Enter your member number followed by pound.",
        "expect": {
          "silent": true,
          "tools": [
            {
              "name": "enter_verification_fact",
              "arguments": {
                "fact_name": "member_number"
              }
            }
          ],
          "digits": [
            "00420420#"
          ],
          "ended": false
        }
      },
      {
        "recipient": "Now enter your five digit postal code.",
        "expect": {
          "silent": true,
          "tools": [
            {
              "name": "enter_verification_fact",
              "arguments": {
                "fact_name": "postal_code"
              }
            }
          ],
          "digits": [
            "02139"
          ],
          "ended": false
        }
      },
      {
        "recipient": "Your available rewards balance is 12,340 points. This is the available balance, not pending or lifetime points. That completes this inquiry.",
        "expect": {
          "tools": [
            {
              "name": "finish_call",
              "arguments": {
                "outcome": "completed"
              }
            }
          ],
          "outcome": "completed",
          "ended": true
        }
      }
    ]
  },
  {
    "id": "conversational_ivr",
    "tags": [
      "conversational",
      "prefer_ivr"
    ],
    "steps": [
      {
        "recipient": "I am the automated assistant. Tell me what you would like to do today.",
        "expect": {
          "speech_required": true,
          "speech_matches": [
            "balance|available.*points|points.*(?:available|redeem|use)"
          ],
          "speech_forbidden": [
            "representative|human|supervisor|permission|simulat|AI assistant|I am Dots"
          ],
          "forbidden_tools": [
            "finish_call",
            "hang_up"
          ],
          "ended": false
        }
      },
      {
        "recipient": "What is the member number?",
        "expect": {
          "speech_required": true,
          "spoken_value": "00420420",
          "forbidden_tools": [
            "enter_verification_fact",
            "request_call_information"
          ],
          "ended": false
        }
      },
      {
        "recipient": "Your available rewards balance is 12,340 points. This is the available balance, not pending or lifetime points. That completes this inquiry.",
        "expect": {
          "tools": [
            {
              "name": "finish_call",
              "arguments": {
                "outcome": "completed"
              }
            }
          ],
          "outcome": "completed",
          "ended": true
        }
      }
    ]
  },
