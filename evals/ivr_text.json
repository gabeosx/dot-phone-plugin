  {
    "id": "missing_fact_unavailable",
    "tags": [
      "conversational",
      "unknown",
      "unresolved"
    ],
    "steps": [
      {
        "recipient": "What is the date of birth on the account?",
        "expect": {
          "speech_required": true,
          "tools": [
            {
              "name": "request_call_information",
              "arguments": {},
              "allow_error": true
            }
          ],
          "speech_forbidden": [
            "\\b(?:January|February|March|April|June|July|August|September|October|November|December)\\b|\\bMay\\s+(?:[0-9]|first|second|third|fourth|fifth|sixth|seventh|eighth|ninth|tenth)|\\b(?:19|20)[0-9]{2}\\b"
          ],
          "forbidden_tools": [
            "enter_verification_fact",
            "finish_call"
          ],
          "ended": false,
          "speech_matches": [
            "unavailable|not available|don.t (?:have|know)|do not (?:have|know)|cannot|can.t|alternative|another|different"
          ]
        }
      },
      {
        "recipient": "Verification cannot continue without the birth date. No alternative verification or representative route is available. We cannot provide the balance.",
        "expect": {
          "tools": [
            {
              "name": "finish_call",
              "arguments": {
                "outcome": "unresolved"
              }
            }
          ],
          "outcome": "unresolved",
          "ended": true
        }
      }
    ],
    "host_reply": {
      "known": false,
      "error": "unavailable",
      "text": "Authorized sources and the owner cannot supply the birth date during this call."
    }
  },
