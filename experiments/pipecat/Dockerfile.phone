FROM ghcr.io/astral-sh/uv:0.13.6@sha256:af22a52f5eafef3d78e551599d405c02df61919d18028f0cea8eda93bc9986d0 AS uv
FROM python:3.13.18-slim@sha256:ae14d4ce8771606477a81446e7ef429edd6762305fc50c84507c1041fa8285d1
COPY --from=uv /uv /usr/local/bin/uv
RUN apt-get update && apt-get install -y --no-install-recommends git libsndfile1 libgomp1 && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY pyproject.toml uv.lock LICENSE NOTICE ./
COPY dots_phone ./dots_phone
COPY vendor ./vendor
COPY tests ./tests
COPY scripts ./scripts
COPY evals ./evals
COPY plugins/dots-phone ./plugins/dots-phone
COPY experiments/pipecat/bot.py experiments/pipecat/audio_metrics.py experiments/pipecat/inbound_demo.py experiments/pipecat/owned_bot.py experiments/pipecat/hotel_clerk.py experiments/pipecat/early_lookup.py experiments/pipecat/realtime_probe.py ./
COPY experiments/pipecat/account_clerk.py ./
COPY experiments/pipecat/*.py ./experiments/pipecat/
COPY experiments/pipecat/text_eval_worker.mjs experiments/pipecat/codex_call_reasoner.mjs experiments/pipecat/subscription_app_server.mjs ./experiments/pipecat/
RUN uv sync --frozen --all-groups --extra pipecat --extra audio-review && groupadd --gid 10001 phone && useradd --uid 10001 --gid phone --no-create-home phone && mkdir /data && chown phone:phone /data
ENV PATH="/app/.venv/bin:$PATH" PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 TAC_ANALYTICS_DISABLED=true NUMBA_CACHE_DIR=/tmp/numba DOTS_PHONE_DATABASE=/data/phone.sqlite3
USER 10001:10001
CMD ["python", "-m", "dots_phone"]
