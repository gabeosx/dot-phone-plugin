# Build the official runtime source with the reviewed Go dependency locks.
FROM --platform=$BUILDPLATFORM python:3.13.18-slim@sha256:ae14d4ce8771606477a81446e7ef429edd6762305fc50c84507c1041fa8285d1 AS source
RUN python - <<'PY'
import hashlib
import io
import tarfile
import urllib.request

url = (
    "https://github.com/openai/tunnel-client/releases/download/v0.0.20/"
    "tunnel-client-runtime-source-v0.0.20.tar.gz"
)
with urllib.request.urlopen(url, timeout=60) as response:
    archive = response.read()
if hashlib.sha256(archive).hexdigest() != "56ed0162eda7c04e6a656e30565c75c10474dfd74eacd7171da45917cfde57a8":
    raise ValueError("Tunnel runtime source checksum does not match")
with tarfile.open(fileobj=io.BytesIO(archive), mode="r:gz") as source:
    source.extractall("/src", filter="data")
PY

FROM --platform=$BUILDPLATFORM golang:1.27.3-alpine@sha256:f2c872bcee949b7be9c490efd02b48a8a2fbf947cdf533f1c58525ec9d8170fd AS build
ENV GOTOOLCHAIN=local
WORKDIR /src
COPY --from=source /src/tunnel-client-runtime-source-v0.0.20/ ./
COPY tunnel-runtime/go.mod tunnel-runtime/go.sum ./
RUN go mod download && go mod verify
ARG TARGETOS
ARG TARGETARCH
RUN --network=none <<'SH'
set -eu
export CGO_ENABLED=0 GOOS="$TARGETOS" GOARCH="$TARGETARCH"
mkdir -p /out/licenses/modules
go build -mod=readonly -trimpath -buildvcs=false \
    -ldflags '-X github.com/openai/tunnel-client/pkg/version.Flavor=runtime -X github.com/openai/tunnel-client/pkg/version.GitSHA=c2144b0904980bcbae2636cdca4f4167e9818e0b' \
    -o /out/tunnel-client ./cmd/client-runtime
cp LICENSE NOTICE /out/licenses/
go version -m /out/tunnel-client > /out/licenses/build-info.txt
go list -mod=readonly -deps -f '{{with .Module}}{{if not .Main}}{{.Path}} {{.Version}} {{.Dir}}{{end}}{{end}}' \
    ./cmd/client-runtime > /tmp/modules
sort -u /tmp/modules | while read -r module version directory; do
    [ -n "$module" ] || continue
    destination="/out/licenses/modules/$module@$version"
    mkdir -p "$destination"
    found=false
    for notice in "$directory"/LICENSE* "$directory"/LICENCE* "$directory"/COPYING* "$directory"/NOTICE*; do
        [ -f "$notice" ] || continue
        cp "$notice" "$destination/"
        found=true
    done
    if [ "$found" = false ]; then
        printf 'Missing license for %s %s\n' "$module" "$version" >&2
        exit 1
    fi
done
SH

FROM python:3.13.18-slim@sha256:ae14d4ce8771606477a81446e7ef429edd6762305fc50c84507c1041fa8285d1
COPY --from=build /out/tunnel-client /usr/local/bin/tunnel-client
COPY --from=build /out/licenses /usr/local/share/licenses/tunnel-client
ENV HOME=/tmp
USER 10001:10001
ENTRYPOINT ["tunnel-client"]
