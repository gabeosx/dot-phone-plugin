diff --git a/test/read-session.test.mjs b/test/read-session.test.mjs
new file mode 100644
--- /dev/null
+++ b/test/read-session.test.mjs
@@ -0,0 +1,17 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import {EventEmitter} from 'node:events';
+import {YahooMail} from '../src/mail.mjs';
+class Fake extends EventEmitter {
+ constructor(){super();this.usable=false;this.auths=0;this.closed=0;}
+ async connect(){this.auths++;this.usable=true;}
+ async logout(){this.closed++;this.usable=false;this.emit('close');}
+ close(){this.closed++;this.usable=false;this.emit('close');}
+}
+function fixture(ms=60000){const m=new YahooMail({email:'test@example.com',password:'fixture',readIdleMs:ms}),clients=[];m.client=()=>{const c=new Fake();clients.push(c);return c;};return {m,clients};}
+test('sequential reads share one connection and explicit close clears it',async()=>{const {m,clients}=fixture();try{assert.equal(await m.readonly(c=>c.usable),true);await m.readonly(c=>c.usable);assert.equal(clients.length,1);assert.equal(clients[0].auths,1);}finally{await m.close();}assert.equal(m.readClient,null);assert.equal(clients[0].closed,1);});
+test('concurrent operations are serialized and do not race mailbox selection',async()=>{const {m,clients}=fixture();const order=[];try{await Promise.all([m.readonly(async()=>{order.push('a');await new Promise(r=>setTimeout(r,10));order.push('b');}),m.readonly(()=>order.push('c'))]);assert.deepEqual(order,['a','b','c']);assert.equal(clients.length,1);}finally{await m.close();}});
+test('idle session expires without keeping process alive; next read reconnects',async()=>{const {m,clients}=fixture(10);await m.readonly(()=>1);await new Promise(r=>setTimeout(r,30));assert.equal(m.readClient,null);await m.readonly(()=>2);assert.equal(clients.length,2);await m.close();});
+test('failed connection is replaced for next read, current operation is never retried',async()=>{const {m,clients}=fixture();let attempts=0;await assert.rejects(m.readonly(c=>{attempts++;c.usable=false;throw Error('disconnected');}));assert.equal(attempts,1);await m.readonly(()=>1);assert.equal(clients.length,2);await m.close();});
+test('write transport stays disposable and never borrows the read session',async()=>{const {m,clients}=fixture();await m.readonly(()=>1);await m.imap(c=>c.usable);assert.equal(clients.length,2);assert.equal(clients[1].closed,1);assert.equal(clients[0].closed,0);await m.close();});
+test('status warms read-only mailbox state without searching or fetching a message',async()=>{const {m,clients}=fixture();let locked=false,released=false;const original=m.client;m.client=()=>{const c=original();c.list=async()=>[{path:'INBOX'}];c.getMailboxLock=async(name,args)=>{assert.equal(name,'INBOX');assert.deepEqual(args,{readOnly:true});locked=true;return {release(){released=true;}};};c.search=()=>assert.fail('No query before the call');c.fetchOne=()=>assert.fail('No message prefetch');return c;};m.smtp=()=>({verify:async()=>{},close(){}});try{const result=await m.status();assert.equal(result.imapAuthenticated,true);assert.ok(locked&&released);assert.equal(clients.length,1);}finally{await m.close();}});
diff --git a/test/read-fetch.test.mjs b/test/read-fetch.test.mjs
new file mode 100644
--- /dev/null
+++ b/test/read-fetch.test.mjs
@@ -0,0 +1,27 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import {YahooMail} from '../src/mail.mjs';
+
+function fixture({size=40,validity='123',source=Buffer.from('Subject: Test\r\nContent-Type: text/plain\r\n\r\nActual source')}={}) {
+  const mail=new YahooMail({email:'test@example.com',password:'synthetic'});
+  let fetches=0,released=false;
+  mail.readonly=operation=>operation({
+    mailbox:{uidValidity:validity},
+    getMailboxLock:async(_path,options)=>{assert.equal(options.readOnly,true);return {release(){released=true;}};},
+    fetchOne:async(uid,query,options)=>{fetches++;assert.equal(uid,19);assert.deepEqual(options,{uid:true});assert.deepEqual(query.source,{maxLength:5*1024*1024+1});return {uid,size,source,envelope:{subject:'Test'},flags:new Set()};},
+  });
+  return {mail,counts:()=>({fetches,released})};
+}
+test('metadata and bounded body use one fetch and preserve source parsing',async()=>{
+  const {mail,counts}=fixture();const result=await mail.read({mailbox:'INBOX',uid:19,uidValidity:'123'});
+  assert.equal(result.text,'Actual source');assert.equal(result.untrustedContent,true);assert.deepEqual(counts(),{fetches:1,released:true});
+});
+test('oversized message is refused without parsing its bounded partial source',async()=>{
+  const {mail,counts}=fixture({size:5*1024*1024+2,source:Buffer.from('invalid partial MIME')});
+  const result=await mail.read({mailbox:'INBOX',uid:19,uidValidity:'123'});
+  assert.match(result.bodyUnavailable,/5 MiB/);assert.equal(result.text,undefined);assert.deepEqual(counts(),{fetches:1,released:true});
+});
+test('UID validity mismatch stops before fetching, and releases the mailbox lock',async()=>{
+  const {mail,counts}=fixture({validity:'456'});
+  await assert.rejects(mail.read({mailbox:'INBOX',uid:19,uidValidity:'123'}),/identifiers changed/);assert.deepEqual(counts(),{fetches:0,released:true});
+});
